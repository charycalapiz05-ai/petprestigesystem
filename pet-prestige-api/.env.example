# ─────────────────────────────────────────
# Pet Prestige API — Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MySQL (XAMPP defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pet_prestige

# JWT Secrets (change these to long random strings!)
JWT_SECRET=change_this_to_a_long_random_secret_string_min_32_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080
